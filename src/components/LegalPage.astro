---
import { legal, type LegalDoc } from "../legal";
import type { Locale } from "../i18n.ts";

interface Props {
  locale: Locale;
  doc: LegalDoc;
}
const { locale, doc } = Astro.props;
const g = legal[doc][locale];
---
<article class="policy-page prose-page">
  <p class="eyebrow">{g.kicker}</p>
  <h1 set:html={g.title}></h1>
  <p class="policy-updated">{g.updated}</p>
  <p class="policy-lede">{g.lede}</p>
  {g.sections.map((s) => (
    <section><h2>{s.heading}</h2><p>{s.body}</p></section>
  ))}

  {doc === "cookies" && g.labels && (
    <div class="cookie-page-inner">
      <div class="cookie-option"><div><h2>{g.sections[0].heading}</h2><p>{g.sections[0].body}</p></div><span class="cookie-status">{g.labels.alwaysOn}</span></div>
      <label class="cookie-option toggle-row" for="analytics-consent">
        <div><h2>{g.sections[1].heading}</h2><p>{g.sections[1].body}</p></div>
        <input id="analytics-consent" type="checkbox" /><span class="toggle-ui" aria-hidden="true"></span>
      </label>
      <div class="cookie-option"><div><h2>{g.sections[2].heading}</h2><p>{g.sections[2].body}</p></div></div>
      <div class="cookie-actions">
        <button class="button button-ink" type="button" id="save-cookie">{g.labels.save}</button>
        <button class="text-link" type="button" id="reject-all">{g.labels.reject}</button>
      </div>
      <p id="cookie-feedback" class="form-feedback" data-saved={g.labels.saved} aria-live="polite"></p>
    </div>
  )}
</article>

{doc === "cookies" && (
  <script is:inline>
  (() => {
    const key = 'tugu-khatulistiwa-analytics';
    const input = document.getElementById('analytics-consent');
    const fb = document.getElementById('cookie-feedback');
    try { input.checked = localStorage.getItem(key) === 'granted'; } catch { input.checked = false; }
    const save = enabled => {
      window.setTuguAnalytics?.(enabled);
      let saved = false;
      try { localStorage.setItem(key, enabled ? 'granted' : 'denied'); saved = true; } catch {}
      if (fb) fb.textContent = saved ? fb.dataset.saved : (document.documentElement.lang === 'en' ? 'Choice applies to this page, but could not be saved for later visits.' : 'Pilihan berlaku pada halaman ini, tetapi tidak dapat disimpan untuk kunjungan berikutnya.');
    };
    document.getElementById('save-cookie')?.addEventListener('click', () => save(input?.checked === true));
    document.getElementById('reject-all')?.addEventListener('click', () => { input.checked = false; save(false); });
  })();
  </script>
)}
