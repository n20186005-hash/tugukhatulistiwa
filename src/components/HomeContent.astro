---
// Homepage body, rendered server-side for a given locale.
import { t, faq, type Locale } from "../i18n";
import { site, heroImage, monumentPhoto, mapUrl, GOVT_TOURISM_URL } from "../../site.config.mjs";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const attractionDescription =
  locale === "en"
    ? "A geographic and educational monument marking the equator in Pontianak, Indonesia."
    : "Monumen geografis dan edukatif yang menandai garis khatulistiwa di Pontianak, Indonesia.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["TouristAttraction", "LocalBusiness"],
  "@id": site ? `${site}/#attraction` : undefined,
  name: "Tugu Khatulistiwa",
  alternateName: ["Equator Monument", "Tugu Khatulistiwa Pontianak", "Khatulistiwa Park"],
  url: site || undefined,
  description: attractionDescription,
  image: [site ? new URL(heroImage, site).toString() : heroImage],
  isAccessibleForFree: false,
  hasMap: mapUrl,
  sameAs: [mapUrl, GOVT_TOURISM_URL],
  address: { "@type": "PostalAddress", streetAddress: "Jl. Khatulistiwa, Batu Layang, Pontianak Utara", addressLocality: "Kota Pontianak", addressRegion: "Kalimantan Barat", postalCode: "78244", addressCountry: "ID" },
  geo: { "@type": "GeoCoordinates", latitude: "0.000721", longitude: "109.322105" },
  openingHoursSpecification: [{ "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"], opens: "08:00", closes: "16:00" }],
  priceRange: "IDR 5,000",
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.5", bestRating: "5", worstRating: "1", ratingCount: "9426" },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq[locale].map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---
<Fragment>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

  <section class="hero" id="top">
    <div class="hero-photograph" style={`background-image:url('${monumentPhoto}')`} aria-label="Tugu Khatulistiwa di Pontianak, karya SunDawn"></div>
    <div class="hero-scrim"></div>
    <div class="hero-copy">
      <p class="eyebrow light">{t(locale, "heroKicker")}</p>
      <h1 set:html={t(locale, "heroTitle")}></h1>
      <p class="hero-intro">{t(locale, "heroIntro")}</p>
      <div class="hero-actions">
        <a class="button button-sun" href="#kunjungan" set:html={t(locale, "heroPlan")}></a>
        <a class="text-link light-link" href={mapUrl} target="_blank" rel="noreferrer" set:html={t(locale, "heroMap")}></a>
      </div>
      <p class="photo-credit">{t(locale, "heroCredit")}</p>
    </div>
    <aside class="hero-ledger" aria-label="Ringkasan kunjungan">
      <p class="ledger-label">{t(locale, "ledgerLabel")}</p>
      <dl>
        <div><dt>{t(locale, "ledgerPlace")}</dt><dd>{t(locale, "ledgerPlaceValue")}</dd></div>
        <div><dt>{t(locale, "ledgerLatitude")}</dt><dd>0°</dd></div>
        <div><dt>{t(locale, "ledgerDuration")}</dt><dd>{t(locale, "ledgerDurationValue")}</dd></div>
        <div><dt>{t(locale, "ledgerHours")}</dt><dd>{t(locale, "ledgerHoursValue")}</dd></div>
      </dl>
      <p class="ledger-note">{t(locale, "ledgerNote")}</p>
    </aside>
    <div class="hero-astronomy" aria-hidden="true"><i></i><i></i><i></i><b>0°</b></div>
    <div class="equator-line hero-line" aria-hidden="true"><span></span><i></i></div>
  </section>

  <section class="intro-section" id="tentang">
    <div class="section-index">01<span></span></div>
    <div class="intro-heading">
      <p class="eyebrow">{t(locale, "aboutKicker")}</p>
      <h2 set:html={t(locale, "aboutTitle")}></h2>
    </div>
    <div class="intro-copy">
      <p>{t(locale, "aboutP1")}</p>
      <p>{t(locale, "aboutP2")}</p>
      <a class="text-link" href="#sejarah" set:html={t(locale, "aboutLink")}></a>
    </div>
    <div class="fact-strip" aria-label="Fakta lokasi">
      <div><span>0°</span><p set:html={t(locale, "factZero")}></p></div>
      <div><span>1928</span><p set:html={t(locale, "factYear")}></p></div>
      <div><span>2×</span><p set:html={t(locale, "factTwice")}></p></div>
      <div><span>±3 km</span><p set:html={t(locale, "factDistance")}></p></div>
    </div>
  </section>

  <section class="history-section" id="sejarah">
    <div class="history-art" aria-hidden="true"><div class="topographic-art"><i></i><i></i><i></i><b>109° 19′ E</b></div></div>
    <div class="history-copy">
      <p class="eyebrow">{t(locale, "historyKicker")}</p>
      <h2 set:html={t(locale, "historyTitle")}></h2>
      <p>{t(locale, "historyIntro")}</p>
      <ol class="timeline">
        <li><span>1928</span><p>{t(locale, "timeline1")}</p></li>
        <li><span>1930</span><p>{t(locale, "timeline2")}</p></li>
        <li><span>1938</span><p>{t(locale, "timeline3")}</p></li>
        <li><span>1990</span><p>{t(locale, "timeline4")}</p></li>
      </ol>
      <p class="source-note">{t(locale, "historySource")}</p>
    </div>
  </section>

  <section class="culmination-section" aria-labelledby="culmination-heading">
    <div class="culmination-copy">
      <p class="eyebrow light">{t(locale, "culminationKicker")}</p>
      <h2 id="culmination-heading" set:html={t(locale, "culminationTitle")}></h2>
      <p>{t(locale, "culminationP1")}</p>
      <p>{t(locale, "culminationP2")}</p>
    </div>
    <figure class="culmination-figure"><div class="solar-diagram" aria-hidden="true"><span></span><i></i><b>0°</b></div><figcaption>{t(locale, "culminationCaption")}</figcaption></figure>
  </section>

  <section class="visit-section" id="kunjungan">
    <div class="section-heading-row">
      <div><p class="eyebrow">{t(locale, "visitKicker")}</p><h2 set:html={t(locale, "visitTitle")}></h2></div>
      <p>{t(locale, "visitIntro")}</p>
    </div>
    <div class="visit-grid">
      <article class="info-card"><span class="card-number">A</span><h3>{t(locale, "visitHoursTitle")}</h3><p>{t(locale, "visitHoursP")}</p></article>
      <article class="info-card"><span class="card-number">B</span><h3>{t(locale, "visitTimingTitle")}</h3><p>{t(locale, "visitTimingP")}</p></article>
      <article class="info-card"><span class="card-number">C</span><h3>{t(locale, "visitDurationTitle")}</h3><p>{t(locale, "visitDurationP")}</p></article>
    </div>
    <div class="facility-band">
      <p class="eyebrow">{t(locale, "facilityKicker")}</p>
      <p>{t(locale, "facilityP")}</p>
    </div>
  </section>

  <section class="route-section" id="rute">
    <div class="route-heading"><p class="eyebrow">{t(locale, "routeKicker")}</p><h2 set:html={t(locale, "routeTitle")}></h2><p>{t(locale, "routeIntro")}</p></div>
    <div class="route-list">
      <details open><summary><span>01</span><b>{t(locale, "routeAirportTitle")}</b><i>+</i></summary><p>{t(locale, "routeAirportP")}</p></details>
      <details><summary><span>02</span><b>{t(locale, "routeCenterTitle")}</b><i>+</i></summary><p>{t(locale, "routeCenterP")}</p></details>
      <details><summary><span>03</span><b>{t(locale, "routeBusTitle")}</b><i>+</i></summary><p>{t(locale, "routeBusP")}</p></details>
      <details><summary><span>04</span><b>{t(locale, "routeDriveTitle")}</b><i>+</i></summary><p>{t(locale, "routeDriveP")}</p></details>
    </div>
    <a class="button button-ink" href={mapUrl} target="_blank" rel="noreferrer" set:html={t(locale, "routeButton")}></a>
  </section>

  <section class="map-section" aria-label="Peta Tugu Khatulistiwa">
    <div class="map-copy"><p class="eyebrow light">{t(locale, "mapKicker")}</p><h2 set:html={t(locale, "mapTitle")}></h2><p>{t(locale, "mapP")}</p></div>
    <iframe title="Peta Tugu Khatulistiwa" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6899.06084470204!2d109.3198152124356!3d0.000920999999069569!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31e2a75b7f18d41d%3A0x959992e0a47ea028!2z6LWk6YGT57qq5b-156KR!5e1!3m2!1szh-CN!2sjp!4v1787105931228!5m2!1szh-CN!2sjp" width="600" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </section>

  <section class="around-section" id="sekitar">
    <div class="section-heading-row"><div><p class="eyebrow">{t(locale, "aroundKicker")}</p><h2 set:html={t(locale, "aroundTitle")}></h2></div><p>{t(locale, "aroundIntro")}</p></div>
    <div class="around-grid">
      <article><span>01</span><h3>{t(locale, "aroundFoodTitle")}</h3><p>{t(locale, "aroundFoodP")}</p></article>
      <article><span>02</span><h3>{t(locale, "aroundStayTitle")}</h3><p>{t(locale, "aroundStayP")}</p></article>
      <article><span>03</span><h3>{t(locale, "aroundPlacesTitle")}</h3><p>{t(locale, "aroundPlacesP")}</p></article>
    </div>
  </section>

  <section class="faq-section" id="faq">
    <div class="faq-heading"><p class="eyebrow">{t(locale, "faqKicker")}</p><h2 set:html={t(locale, "faqTitle")}></h2></div>
    <div class="faq-list">
      {faq[locale].map((item, i) => (
        <details>
          <summary><span>{String(i + 1).padStart(2, "0")}</span><b>{item.q}</b><i>+</i></summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="sources-section">
    <div><p class="eyebrow">{t(locale, "sourcesKicker")}</p><h2 set:html={t(locale, "sourcesTitle")}></h2></div>
    <div class="source-links">
      <a href="https://disporapar.pontianak.go.id/pariwisata/6" target="_blank" rel="noreferrer"><span>01</span><b>{t(locale, "source1")}</b><i>↗</i></a>
      <a href="https://www.indonesia.travel/id/id/travel-ideas/culture/tugu-khatulistiwa" target="_blank" rel="noreferrer"><span>02</span><b>{t(locale, "source2")}</b><i>↗</i></a>
      <a href="https://sisparnas.kemenpar.go.id/p/79955" target="_blank" rel="noreferrer"><span>03</span><b>{t(locale, "source3")}</b><i>↗</i></a>
    </div>
  </section>
</Fragment>
