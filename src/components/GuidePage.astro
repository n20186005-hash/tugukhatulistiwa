---
import { site } from "../../site.config.mjs";
import { localizedPath, type Locale } from "../i18n";
import { guides, type GuideTopic } from "../guides";

interface Props {
  locale: Locale;
  topic: GuideTopic;
}
const { locale, topic } = Astro.props;
const g = guides[topic][locale];

const topicPath = `/${topic}`;
const homePath = localizedPath("/", locale);
const pagePath = localizedPath(topicPath, locale);

const crumbs = [
  { name: locale === "en" ? "Home" : "Beranda", path: homePath },
  { name: g.title, path: pagePath },
];

const breadcrumbLd = site
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: new URL(c.path, site).toString(),
      })),
    }
  : null;

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: g.faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---
<Fragment>
  {breadcrumbLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
  )}
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>

  <article class="policy-page prose-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      {crumbs.map((c, i) => (
        <span class="crumb">
          {i < crumbs.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
          {i < crumbs.length - 1 && <span class="crumb-sep">/</span>}
        </span>
      ))}
    </nav>
    <h1>{g.title}</h1>
    {g.intro.map((p, i) => (
      <p class={i === 0 ? "policy-lede" : ""}>{p}</p>
    ))}
    {g.sections.map((s) => (
      <section>
        <h2>{s.heading}</h2>
        <p>{s.body}</p>
      </section>
    ))}
    <section class="guide-faq">
      <h2>{locale === "en" ? "Frequently asked questions" : "Pertanyaan umum"}</h2>
      <div class="faq-list">
        {g.faq.map((item, i) => (
          <details>
            <summary><span>{String(i + 1).padStart(2, "0")}</span><b>{item.q}</b><i>+</i></summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>
    <p class="back-home">
      <a class="text-link" href={homePath}>{locale === "en" ? "Back to the guide" : "Kembali ke panduan"} <span>↗</span></a>
    </p>
  </article>
</Fragment>

<style>
  .breadcrumb {
    font: 500 0.62rem/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 2.5rem;
  }
  .crumb a { color: var(--terra); }
  .crumb-sep { margin: 0 0.5rem; color: var(--ink-soft); }
  .guide-faq { margin-top: 1rem; }
  .back-home { margin-top: 3rem; }
</style>
