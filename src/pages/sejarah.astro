---
import SiteLayout from "../layouts/SiteLayout.astro";
import GuidePage from "../components/GuidePage.astro";
import { guides } from "../guides.ts";
import { SITE_NAME } from "../../site.config.mjs";

const topic = "sejarah";
const g = guides[topic]["id"];
const title = `${g.title} | ${SITE_NAME}`;
---
<SiteLayout title={title} description={g.description} locale="id" path={`/${topic}`}>
  <GuidePage locale="id" topic={topic} />
</SiteLayout>
