nal design and text are protected. Photos are displayed under their stated licences and remain the rights of their photographers. Google Maps is used under Google’s terms of service.",termsH4:"Limitation of liability",termsP4:"This site is provided “as is” without warranty. We are not liable for loss resulting from use of this information, including travel decisions made from site content."}};function applyTerms(lang){const c=termsCopy[lang]||termsCopy.id;document.querySelectorAll('[data-i18n]').forEach(n=>{if(c[n.dataset.i18n])n.innerHTML=c[n.dataset.i18n]})}applyTerms(document.documentElement.lang);window.addEventListener('tugu-language-change',e=>applyTerms(e.detail));</script>
