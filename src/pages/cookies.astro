---
import SiteLayout from "../layouts/SiteLayout.astro";
import LegalPage from "../components/LegalPage.astro";
import { legal } from "../legal.ts";
import { SITE_NAME } from "../../site.config.mjs";

const doc = "cookies";
const g = legal[doc]["id"];
const title = `${g.title.replace(/<[^>]+>/g, "")} | ${SITE_NAME}`;
---
<SiteLayout title={title} description={g.lede} locale="id" path={`/${doc}`}>
  <LegalPage locale="id" doc={doc} />
</SiteLayout>
