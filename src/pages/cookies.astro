---
// Design reminder: consent is a direct, transparent field-note page, not an opaque modal.
import SiteLayout from "../layouts/SiteLayout.astro";
import { withSiteName } from "../../site.config.mjs";
---
<SiteLayout title={withSiteName("Pengaturan Cookie")} description="Pengaturan cookie untuk Panduan Tugu Khatulistiwa.">
  <article class="policy-page cookie-page">
    <p class="eyebrow" data-i18n="cookieKicker">DOKUMEN · 03</p><h1 data-i18n="cookieTitle">Pengaturan<br /><em>Cookie.</em></h1><p class="policy-updated" data-i18n="updated">Terakhir diperbarui: Agustus 2026</p>
    <p class="policy-lede" data-i18n="cookieLede">Cookie membantu situs mengingat preferensi Anda. Anda dapat mengelola izin analitik di bawah ini kapan saja.</p>
    <div class="cookie-option"><div><h2 data-i18n="cookieEssentialTitle">Cookie penting</h2><p data-i18n="cookieEssentialP">Diperlukan agar pengaturan dasar situs berfungsi dan tidak dapat dimatikan di halaman ini.</p></div><span class="cookie-status" data-i18n="alwaysOn">Selalu aktif</span></div>
    <label class="cookie-option toggle-row" for="analytics-consent"><div><h2 data-i18n="cookieAnalyticsTitle">Cookie analitik</h2><p data-i18n="cookieAnalyticsP">Jika diizinkan, Google Analytics mengumpulkan data penggunaan anonim untuk membantu memahami bagaimana panduan ini digunakan.</p></div><input id="analytics-consent" type="checkbox" /><span class="toggle-ui" aria-hidden="true"></span></label>
    <div class="cookie-option"><div><h2 data-i18n="cookiePreferenceTitle">Preferensi</h2><p data-i18n="cookiePreferenceP">Pilihan bahasa disimpan secara lokal di browser Anda agar kunjungan berikutnya konsisten.</p></div><span class="cookie-status" data-i18n="alwaysOn">Selalu aktif</span></div>
    <div class="cookie-actions"><button class="button button-ink" type="button" id="save-cookie" data-i18n="savePreference">Simpan preferensi</button><button class="text-link" type="button" id="reject-all" data-i18n="rejectAll">Tolak analitik</button></div><p id="cookie-feedback" class="form-feedback" aria-live="polite"></p>
  </article>
  <script is:inline>
    const cookieCopy={id:{cookieKicker:"DOKUMEN · 03",cookieTitle:"Pengaturan<br /><em>Cookie.</em>",updated:"Terakhir diperbarui: Agustus 2026",cookieLede:"Cookie membantu situs mengingat preferensi Anda. Anda dapat mengelola izin analitik di bawah ini kapan saja.",cookieEssentialTitle:"Cookie penting",cookieEssentialP:"Diperlukan agar pengaturan dasar situs berfungsi dan tidak dapat dimatikan di halaman ini.",alwaysOn:"Selalu aktif",cookieAnalyticsTitle:"Cookie analitik",cookieAnalyticsP:"Jika diizinkan, Google Analytics mengumpulkan data penggunaan anonim untuk membantu memahami bagaimana panduan ini digunakan.",cookiePreferenceTitle:"Preferensi",cookiePreferenceP:"Pilihan bahasa disimpan secara lokal di browser Anda agar kunjungan berikutnya konsisten.",savePreference:"Simpan preferensi",rejectAll:"Tolak analitik",saved:"Preferensi Anda telah disimpan."},en:{cookieKicker:"DOCUMENT · 03",cookieTitle:"Cookie<br /><em>Settings.</em>",updated:"Last updated: August 2026",cookieLede:"Cookies help the site remember your preferences. You can manage analytics permission below at any time.",cookieEssentialTitle:"Essential cookies",cookieEssentialP:"These are needed for basic site settings to work and cannot be turned off on this page.",alwaysOn:"Always active",cookieAnalyticsTitle:"Analytics cookies",cookieAnalyticsP:"If allowed, Google Analytics collects anonymous usage data to help us understand how this guide is used.",cookiePreferenceTitle:"Preferences",cookiePreferenceP:"Your language choice is saved locally in your browser so later visits remain consistent.",savePreference:"Save preferences",rejectAll:"Reject analytics",saved:"Your preferences have been saved."}};function applyCookies(lang){const c=cookieCopy[lang]||cookieCopy.id;document.querySelectorAll('[data-i18n]').forEach(n=>{if(c[n.dataset.i18n])n.innerHTML=c[n.dataset.i18n]})}const consentKey='tugu-khatulistiwa-analytics';const input=document.getElementById('analytics-consent');input.checked=localStorage.getItem(consentKey)==='granted';function enableAnalytics(){if(document.querySelector('[data-ga4]'))return;const s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP';s.dataset.ga4='true';document.head.appendChild(s);window.dataLayer=window.dataLayer||[];window.gtag=function(){window.dataLayer.push(arguments)};window.gtag('js',new Date());window.gtag('config','G-HXM22WWPKP')}function save(v){localStorage.setItem(consentKey,v?'granted':'denied');if(v)enableAnalytics();document.getElementById('cookie-feedback').textContent=(cookieCopy[document.documentElement.lang]||cookieCopy.id).saved}document.getElementById('save-cookie').addEventListener('click',()=>save(input.checked));document.getElementById('reject-all').addEventListener('click',()=>{input.checked=false;save(false)});if(input.checked)enableAnalytics();applyCookies(document.documentElement.lang);window.addEventListener('tugu-language-change',e=>applyCookies(e.detail));
  </script>
</SiteLayout>
