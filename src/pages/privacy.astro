ytics is loaded only when you allow analytics cookies. These services maintain their own privacy policies.",privacyH4:"Your rights",privacyP4:"Under the GDPR and relevant regulations, you may request access, correction or deletion of personal data, object to certain processing, or lodge a complaint with a relevant authority."}};function applyPrivacy(lang){const c=privacyCopy[lang]||privacyCopy.id;document.querySelectorAll('[data-i18n]').forEach(n=>{if(c[n.dataset.i18n])n.innerHTML=c[n.dataset.i18n]})}applyPrivacy(document.documentElement.lang);window.addEventListener('tugu-language-change',e=>applyPrivacy(e.detail));
