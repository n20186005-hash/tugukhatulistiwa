---
import SiteLayout from "../layouts/SiteLayout.astro";
import HomeContent from "../components/HomeContent.astro";
import { SITE_NAME } from "../../site.config.mjs";

const title = `${SITE_NAME}: Tiket, Jam Buka & Sejarah`;
const description = "Panduan wisata independen Tugu Khatulistiwa Pontianak: sejarah, jam buka, harga tiket, rute lokasi, dan fenomena kulminasi matahari.";
---
<SiteLayout title={title} description={description} locale="id" path="/">
  <HomeContent locale="id" />
</SiteLayout>
