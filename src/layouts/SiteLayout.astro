---
// Design reminder: “Astronomical Field Notes” uses paper-like space, indigo structure, terracotta accents, and editorial hierarchy.
import "../styles/global.css";
import { site, SITE_NAME, SITE_NAME_EN, heroImage } from "../../site.config.mjs";
import { t, localizedPath, hreflangAlternates, defaultLocale, type Locale } from "../i18n";

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Base (id) path used for canonical + hreflang, e.g. "/" or "/sejarah". */
  path?: string;
}

const { title, description, locale = defaultLocale, path = "/" } = Astro.props;
const canonical = site ? new URL(localizedPath(path, locale), site).toString() : undefined;
const alternates = site ? hreflangAlternates(path, site) : [];
const ogLocale = locale === "en" ? "en_US" : "id_ID";
const siteName = locale === "en" ? SITE_NAME_EN : SITE_NAME;

const home = localizedPath("/", locale);
const navItems = [
  { href: `${home}#tentang`, key: "navAbout" },
  { href: `${home}#sejarah`, key: "navHistory" },
  { href: `${home}#kunjungan`, key: "navVisit" },
  { href: `${home}#rute`, key: "navRoute" },
  { href: `${home}#sekitar`, key: "navAround" },
  { href: `${home}#faq`, key: "navFaq" },
];
const switchHref = localizedPath(path, locale === "en" ? "id" : "en");
const legal = {
  privacy: localizedPath("/privacy", locale),
  terms: localizedPath("/terms", locale),
  cookies: localizedPath("/cookies", locale),
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#142A42" />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" sizes="16x16" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" sizes="32x32" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={site ? new URL(heroImage, site).toString() : heroImage} />
    <meta property="og:image:alt" content="Tugu Khatulistiwa (Equator Monument) in Pontianak, Indonesia" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t(locale, "skip")}</a>
    <header class="site-header">
      <a class="brand" href={home} aria-label="Tugu Khatulistiwa">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="18"/><path d="M8 34H56"/><circle cx="32" cy="34" r="4.5"/><path d="M32 10V23"/></svg></span>
        <span class="brand-copy"><b>Tugu Khatulistiwa</b><small>{t(locale, "brandKicker")}</small></span>
      </a>
      <nav class="desktop-nav" aria-label="Navigasi utama">
        {navItems.map((item) => (
          <a href={item.href}>{t(locale, item.key)}</a>
        ))}
      </nav>
      <a class="language-toggle" href={switchHref} aria-label={t(locale, "switchLanguageAria")}>{t(locale, "switchLanguage")}</a>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="footer-rule"><span></span><i></i><span></span></div>
      <div class="footer-grid">
        <div>
          <p class="eyebrow">{t(locale, "footerGuide")}</p>
          <p>{t(locale, "footerNonprofit")}</p>
        </div>
        <div>
          <p class="eyebrow">{t(locale, "footerSourcesLabel")}</p>
          <p>{t(locale, "footerSources")}</p>
        </div>
        <div class="footer-links">
          <a href={legal.privacy}>{t(locale, "privacy")}</a>
          <a href={legal.terms}>{t(locale, "terms")}</a>
          <a href={legal.cookies}>{t(locale, "cookies")}</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>{t(locale, "footerPhoto")}</span>
        <span>{t(locale, "footerCopyright")}</span>
      </div>
    </footer>
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(() => {}));
      }
    </script>
  </body>
</html>
